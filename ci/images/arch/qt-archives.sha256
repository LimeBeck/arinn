d8fe882cae71284a7ca906b70b42840376882fe96f22fce1ba5a7a70ceeec799  ./qtbase-Linux-RHEL_8_10-GCC-Linux-RHEL_8_10-X86_64.7z
6330a5ed0138393468be3ddcca458606e14a607f7191d8dbad3978004bdf29ee  ./qtdeclarative-Linux-RHEL_8_10-GCC-Linux-RHEL_8_10-X86_64.7z
e330eb3abed3e0b9c9a278da971ec67306969f35020a3d54350a6ee86d57983d  ./qtsvg-Linux-RHEL_8_10-GCC-Linux-RHEL_8_10-X86_64.7z
a39477caa537743afb5575e5c65018a7d62e47ccf15a4e3444ecc43208ac1047  ./qttools-Linux-RHEL_8_10-GCC-Linux-RHEL_8_10-X86_64.7z
