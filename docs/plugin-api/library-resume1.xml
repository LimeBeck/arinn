<node>
  <interface name="org.arinn.LibraryResume1">
    <method name="GetResumes">
      <arg name="token" type="s" direction="in" />
      <arg type="(sta(sxxbt)s)" direction="out" />
    </method>
    <method name="SetProgress">
      <arg name="generation" type="s" direction="in" />
      <arg name="content_id" type="s" direction="in" />
      <arg name="position_us" type="x" direction="in" />
      <arg name="duration_us" type="x" direction="in" />
      <arg name="ended" type="b" direction="in" />
    </method>
    <method name="RestartFromBeginning">
      <arg name="generation" type="s" direction="in" />
      <arg name="content_id" type="s" direction="in" />
    </method>
    <signal name="StateChanged">
      <arg name="generation" type="s" />
      <arg name="revision" type="t" />
    </signal>
  </interface>
</node>
