# Built by .github/workflows/package.yml from a `git archive` tarball of the
# checked-out commit. pkgver is set from the Cargo workspace version by
# scripts/release.py; do not edit it by hand.

pkgname=arinn
pkgver=0.0.1
pkgrel=1
pkgdesc='TV-first shell for a Linux HTPC (pre-alpha prototype)'
arch=('x86_64')
url='https://github.com/LimeBeck/arinn'
license=('GPL-3.0-or-later' 'MIT OR Apache-2.0' 'CC-BY-SA-4.0')
depends=('gcc-libs' 'glibc' 'glib2' 'dbus' 'systemd' 'qt6-base' 'qt6-declarative' 'qt6-svg')
makedepends=('cargo' 'cmake' 'ninja')
checkdepends=('python')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  cargo build --frozen --release --example private-systemd
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
  cmake --build build
}

check() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/arinnd "${pkgdir}/usr/bin/arinnd"
  install -Dm755 target/release/arinnctl "${pkgdir}/usr/bin/arinnctl"
  install -Dm755 build/apps/arinn-shell/arinn-shell "${pkgdir}/usr/bin/arinn-shell"
  install -Dm755 target/release/arinn-plugin-demo "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-demo"
  install -Dm755 target/release/arinn-plugin-desktop "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-desktop"
  install -Dm644 plugins/desktop/desktop.toml "${pkgdir}/usr/share/arinn/plugins/desktop.toml"
  install -Dm644 plugins/demo/demo.toml "${pkgdir}/usr/share/arinn/plugins/demo.toml"
  install -Dm644 platform/kde/phase0.js "${pkgdir}/usr/share/arinn/kwin/phase0.js"
  install -Dm644 README.md CHANGELOG.md -t "${pkgdir}/usr/share/doc/${pkgname}/"
  install -Dm644 LICENSES/*.txt -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
