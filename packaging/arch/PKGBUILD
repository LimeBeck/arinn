# Built by .github/workflows/package.yml from a `git archive` tarball of the
# checked-out commit. pkgver is set from the Cargo workspace version by
# scripts/release.py; do not edit it by hand. A tag builds this version; every
# other build replaces it with `<version>.r<commits>.g<12 hex>` from
# scripts/build_id.py --pkgver in its copy, so each snapshot upgrades the one
# before it (#357).
#
# The shell needs Qt 6.8 or newer, the minimum supported Qt (ADR-0104). CI
# builds it against a Qt 6.8 SDK named by ARINN_QT_FLOOR_PREFIX, so the
# package runs on every system whose Qt meets the depends below (#416); a
# local build uses the system Qt and needs that Qt at run time.

pkgname=arinn
pkgver=0.1.0
pkgrel=1
pkgdesc='TV-first shell for a Linux HTPC (pre-alpha prototype)'
arch=('x86_64')
url='https://github.com/LimeBeck/arinn'
license=('GPL-3.0-or-later' 'MIT OR Apache-2.0' 'CC-BY-SA-4.0')
depends=('gcc-libs' 'glibc' 'glib2>=2.86' 'dbus' 'systemd' 'qt6-base>=6.8' 'qt6-declarative>=6.8' 'qt6-svg>=6.8' 'curl' 'libunwind' 'openssl')
optdepends=('mpv: local file playback' 'ffmpeg: seek thumbnails for the mpv provider; video duration and audio/subtitle languages for the library provider' 'transmission-cli: local Transmission daemon for the download provider')
makedepends=('cargo' 'cmake' 'ninja' 'python' 'qt6-tools')
options=('!lto')
install=arinn.install
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  # A git archive gives every file the commit time as its mtime. Cargo
  # rebuilds a workspace crate only when its sources are newer than the
  # cached build, so with the CI target cache (ADR-0047) an older commit
  # time could package stale binaries (#238). Make the sources newer than
  # any cached artifact; dependencies from the registry stay cached.
  find . -type f -exec touch -c {} +
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # CI may point this at a cached directory outside $srcdir (ADR-0047).
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --frozen --release
  cargo build --frozen --release --example private-systemd
  # No build RPATH: the binary is installed from the build tree and must not
  # point at the SDK prefix.
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SKIP_BUILD_RPATH=ON \
    ${ARINN_QT_FLOOR_PREFIX:+"-DCMAKE_PREFIX_PATH=$ARINN_QT_FLOOR_PREFIX"}
  # Only the installed shell; the Qt test executables, gallery and perf
  # harness are built and run by the CI integration job (ADR-0092).
  cmake --build build --target arinn-shell
}

check() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo test --frozen --release
}

package() {
  cd "${pkgname}-${pkgver}"
  local target="${CARGO_TARGET_DIR:-target}"
  install -Dm755 "${target}"/release/arinn-platform-x11 "${pkgdir}/usr/bin/arinn-platform-x11"
  install -Dm755 "${target}"/release/arinn-xfce-session "${pkgdir}/usr/lib/arinn/arinn-xfce-session"
  # Template only: users opt in by copying it to their XDG autostart directory.
  install -Dm644 packaging/autostart/org.arinn.XfceSession.desktop \
    "${pkgdir}/usr/share/arinn/autostart/org.arinn.XfceSession.desktop"
  install -Dm755 "${target}"/release/arinnd "${pkgdir}/usr/bin/arinnd"
  install -Dm755 "${target}"/release/arinnctl "${pkgdir}/usr/bin/arinnctl"
  install -Dm755 build/apps/arinn-shell/arinn-shell "${pkgdir}/usr/bin/arinn-shell"
  install -Dm755 "${target}"/release/arinn-plugin-demo "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-demo"
  install -Dm755 "${target}"/release/arinn-plugin-desktop "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-desktop"
  install -Dm644 plugins/desktop/desktop.toml "${pkgdir}/usr/share/arinn/plugins/desktop.toml"
  install -Dm644 plugins/demo/demo.toml "${pkgdir}/usr/share/arinn/plugins/demo.toml"
  install -Dm755 "${target}"/release/arinn-plugin-mpris "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-mpris"
  install -Dm644 plugins/mpris/mpris.toml "${pkgdir}/usr/share/arinn/plugins/mpris.toml"
  install -Dm755 "${target}"/release/arinn-plugin-library "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-library"
  install -Dm644 plugins/library/library.toml "${pkgdir}/usr/share/arinn/plugins/library.toml"
  install -Dm755 "${target}"/release/arinn-plugin-mpv "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-mpv"
  install -Dm644 plugins/mpv/mpv.toml "${pkgdir}/usr/share/arinn/plugins/mpv.toml"
  install -Dm755 "${target}"/release/arinn-plugin-transmission "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-transmission"
  install -Dm644 plugins/transmission/transmission.toml "${pkgdir}/usr/share/arinn/plugins/transmission.toml"
  # Chrome/Chromium integration (ADR-0048): provider, native host, the host
  # manifest for both browsers and the unpacked extension.
  install -Dm755 "${target}"/release/arinn-plugin-chrome "${pkgdir}/usr/lib/arinn/plugins/arinn-plugin-chrome"
  install -Dm644 plugins/chrome/chrome.toml "${pkgdir}/usr/share/arinn/plugins/chrome.toml"
  install -Dm755 "${target}"/release/arinn-chrome-host "${pkgdir}/usr/lib/arinn/arinn-chrome-host"
  install -Dm644 packaging/chrome/org.arinn.chrome_host.json \
    "${pkgdir}/etc/opt/chrome/native-messaging-hosts/org.arinn.chrome_host.json"
  install -Dm644 packaging/chrome/org.arinn.chrome_host.json \
    "${pkgdir}/etc/chromium/native-messaging-hosts/org.arinn.chrome_host.json"
  install -Dm644 plugins/chrome/extension/manifest.json plugins/chrome/extension/background.js \
    -t "${pkgdir}/usr/share/arinn/chrome-extension/"
  install -Dm644 packaging/web-shortcuts/web-shortcuts.toml "${pkgdir}/usr/share/arinn/web-shortcuts.toml"
  install -Dm644 packaging/browser/browser-applications.toml "${pkgdir}/usr/share/arinn/browser-applications.toml"
  install -Dm644 packaging/browser/search-engines.toml "${pkgdir}/usr/share/arinn/search-engines.toml"
  install -Dm644 platform/kde/phase0.js "${pkgdir}/usr/share/arinn/kwin/phase0.js"
  install -Dm755 platform/kde/arinn-kwin-adapter "${pkgdir}/usr/lib/arinn/arinn-kwin-adapter"
  install -Dm755 platform/kde/arinn-shell-launch "${pkgdir}/usr/lib/arinn/arinn-shell-launch"
  # Menu entry and icon (#289); starting Arinn from the menu does not enable autostart.
  install -Dm755 packaging/bin/arinn-open "${pkgdir}/usr/lib/arinn/arinn-open"
  # Restarts running Arinn user services after an upgrade (#355).
  install -Dm755 packaging/bin/arinn-restart-user-services "${pkgdir}/usr/lib/arinn/arinn-restart-user-services"
  install -Dm644 packaging/arch/arinn-restart-user-services.hook \
    "${pkgdir}/usr/share/libalpm/hooks/arinn-restart-user-services.hook"
  install -Dm644 packaging/desktop/org.arinn.Shell.desktop "${pkgdir}/usr/share/applications/org.arinn.Shell.desktop"
  install -Dm644 packaging/icons/org.arinn.Shell.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/org.arinn.Shell.svg"
  # Session units are installed but never enabled by the package (ADR-0042).
  install -Dm644 packaging/systemd/arinn-session.target packaging/systemd/arinnd.service \
    packaging/systemd/arinn-shell.service packaging/systemd/arinn-kwin.service \
    packaging/systemd/arinn-ewmh.service packaging/systemd/arinn-ewmh-session.target \
    -t "${pkgdir}/usr/lib/systemd/user/"
  install -Dm644 README.md CHANGELOG.md -t "${pkgdir}/usr/share/doc/${pkgname}/"
  install -Dm644 build/observability/native/licenses/*-LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
  install -Dm644 LICENSES/*.txt -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
