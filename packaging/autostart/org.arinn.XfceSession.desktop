[Desktop Entry]
Type=Application
Name=Arinn XFCE session
Comment=Start Arinn for this XFCE X11 login
Exec=/usr/lib/arinn/arinn-xfce-session
TryExec=/usr/lib/arinn/arinn-xfce-session
OnlyShowIn=XFCE;
Terminal=false
