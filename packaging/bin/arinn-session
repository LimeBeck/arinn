#!/bin/sh
# SPDX-FileCopyrightText: 2026 Arinn contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Login session entry for the dedicated Arinn session (ADR-0107):
#   arinn-session plasma   /usr/share/wayland-sessions/arinn.desktop
#   arinn-session xfce     /usr/share/xsessions/arinn-xfce.desktop
#
# It starts the desktop and, unless the user switched to the plain desktop
# (arinn-session-switch), the Arinn session units on top of it. It never
# needs privileges and changes no display manager configuration.
set -u

[ "$#" -eq 1 ] || set -- invalid
case "$1" in
plasma) desktop=startplasma-wayland ;;
xfce) desktop=startxfce4 ;;
*)
    echo "arinn-session: usage: arinn-session plasma|xfce" >&2
    exit 2
    ;;
esac
entry=$1

# The recorded choice in "$1": desktop only for exactly "desktop", with at
# most one trailing newline; arinn for any other content; nothing when the
# file is missing. arinn-session and arinn-session-switch share this rule.
recorded_mode() {
    [ -f "$1" ] || return 0
    # Command substitution drops NUL bytes; keep them as "?" so "desk\0top"
    # is not read as "desktop".
    content=$(head -c 16 "$1" | tr '\000' '?' && printf x) || content=
    case "$content" in
    "desktop
x" | desktopx) echo desktop ;;
    *) echo arinn ;;
    esac
}

# The user's choice for this entry. Anything but exactly "desktop" starts
# Arinn: a missing or damaged file must not hide the TV shell.
mode_file="${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/arinn/session-mode"
mode=arinn
if [ "$(recorded_mode "$mode_file")" = desktop ]; then
    mode=desktop
fi
# Replaces the (sub)shell with the desktop. Without job control, sh starts a
# background command with SIGINT and SIGQUIT ignored, and the whole desktop
# would inherit that; restore the defaults the stock session entries have.
start_desktop() {
    if env --default-signal=INT,QUIT true 2>/dev/null; then
        exec env --default-signal=INT,QUIT "$desktop"
    fi
    exec "$desktop"
}

if [ "$mode" = desktop ]; then
    # A wrapper killed earlier may have left its entry marker in a user
    # manager that outlived it (lingering, SDDM Relogin=true). The mode file
    # is named in both environments, so Return to Arinn writes the file this
    # login read wherever it is started from.
    systemctl --user unset-environment ARINN_SESSION_ENTRY >/dev/null 2>&1
    systemctl --user set-environment "ARINN_SESSION_MODE=$mode_file" >/dev/null 2>&1
    ARINN_SESSION_MODE=$mode_file
    export ARINN_SESSION_MODE
    unset ARINN_SESSION_ENTRY
    start_desktop
fi

# The XFCE helper and the desktop must share one session bus. pam_systemd
# normally exports it; without it startxfce4 would start a private bus.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] &&
    [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    export DBUS_SESSION_BUS_ADDRESS
fi

# The desktop session carries the entry marker as well, so the XFCE
# launcher (arinn-xfce-session) binds the user manager's marker to this
# login: a marker a killed wrapper left in a lingering user manager is
# cleared by a stock XFCE login that lacks it (ADR-0111).
ARINN_SESSION_ENTRY=$entry
export ARINN_SESSION_ENTRY

# The background subshell execs the desktop, so $! is the desktop's pid.
start_desktop &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null' TERM HUP INT

# Wait until the desktop is ready for Arinn: Plasma has activated
# graphical-session.target, or the XFCE session manager owns its name.
ready() {
    case "$entry" in
    plasma) systemctl --user is-active --quiet graphical-session.target ;;
    xfce) busctl --user status org.xfce.SessionManager >/dev/null 2>&1 ;;
    esac
}
tries=0
started=false
helper=
while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 240 ]; do
    if ready; then
        # Marks this login as the dedicated session for the daemon's
        # "Switch to desktop", and names the mode file this login read, so
        # the switch writes the same file whatever XDG_STATE_HOME the user
        # manager has. Cleared when the desktop exits.
        systemctl --user set-environment "ARINN_SESSION_ENTRY=$entry" \
            "ARINN_SESSION_MODE=$mode_file" || break
        case "$entry" in
        plasma) systemctl --user start arinn-session.target && started=true ;;
        # The helper owns the EWMH target and stops it with the XFCE session.
        xfce)
            /usr/lib/arinn/arinn-xfce-session &
            helper=$!
            ;;
        esac
        break
    fi
    tries=$((tries + 1))
    sleep 0.5
done
# The helper has taken over once it owns org.arinn.XfceSession. After a fast
# re-login it first waits up to 60 s for the previous login's helper to
# release the name while that one stops the EWMH target (#483). A helper
# that exits before it owns the name did not start Arinn.
if [ -n "$helper" ]; then
    tries=0
    while kill -0 "$pid" 2>/dev/null && kill -0 "$helper" 2>/dev/null &&
        [ "$tries" -lt 150 ]; do
        if busctl --user status org.arinn.XfceSession 2>/dev/null |
            grep -qx "PID=$helper"; then
            started=true
            break
        fi
        tries=$((tries + 1))
        sleep 0.5
    done
fi
if [ "$started" != true ] && kill -0 "$pid" 2>/dev/null; then
    # Fail open: the desktop stays usable, and Return to Arinn is available.
    echo "arinn-session: Arinn did not start; the desktop continues without it" >&2
fi

status=0
while :; do
    wait "$pid"
    status=$?
    kill -0 "$pid" 2>/dev/null || break
done
trap - TERM HUP INT
if [ "$entry" = plasma ]; then
    systemctl --user stop arinn-session.target >/dev/null 2>&1
fi
systemctl --user unset-environment ARINN_SESSION_ENTRY ARINN_SESSION_MODE >/dev/null 2>&1
exit "$status"
