#!/bin/sh
# SPDX-FileCopyrightText: 2026 Arinn contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Switch between the Arinn session and the plain desktop (ADR-0107):
#   arinn-session-switch desktop          from Arinn, after its own confirmation
#   arinn-session-switch arinn --prompt   from the "Return to Arinn" launcher
#
# Records what the Arinn login entry starts next for this user, then asks the
# running desktop to log out. Unprivileged: it writes one file in the user's
# own state directory and calls the desktop's own logout on the session bus.
# A logout request the desktop refuses restores the previous choice and exits
# 1. A logout the desktop accepts and cancels later (an application's unsaved
# work prompt) is not detected; the recorded choice stays.
#
# Without --prompt (the daemon's "Switch to desktop") the logout call is
# bounded to 5 s, below the daemon's 10 s limit, so a desktop that does not
# answer is handled like a refusal: the previous choice is restored.
#
# Exit status: 0 the desktop accepted the logout request; 1 no supported
# desktop, or the desktop refused or did not answer (previous choice
# restored); 2 usage; 3 the choice could not be recorded (no logout asked).
set -u

[ "$#" -le 2 ] || set -- invalid
case "${1:-}" in
arinn | desktop) mode=$1 ;;
*)
    echo "arinn-session-switch: usage: arinn-session-switch arinn|desktop [--prompt]" >&2
    exit 2
    ;;
esac
prompt=false
case "${2:-}" in
"") ;;
--prompt) prompt=true ;;
*)
    echo "arinn-session-switch: unknown option" >&2
    exit 2
    ;;
esac

# The desktop to log out of: the dedicated session exports its entry; an
# ordinary session is recognised by the standard desktop name.
desktop=${ARINN_SESSION_ENTRY:-}
if [ -z "$desktop" ]; then
    case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:KDE:*) desktop=plasma ;;
    *:XFCE:*) desktop=xfce ;;
    esac
fi
case "$desktop" in
plasma | xfce) ;;
*)
    echo "arinn-session-switch: no supported desktop session to log out of" >&2
    exit 1
    ;;
esac

# The file the Arinn session read at login (exported by arinn-session);
# otherwise the same XDG resolution the session uses.
case "${ARINN_SESSION_MODE:-}" in
/*/arinn/session-mode)
    file=$ARINN_SESSION_MODE
    directory=${file%/session-mode}
    ;;
*)
    if [ -z "${HOME:-}" ] && [ -z "${XDG_STATE_HOME:-}" ]; then
        echo "arinn-session-switch: no state directory" >&2
        exit 3
    fi
    directory="${XDG_STATE_HOME:-$HOME/.local/state}/arinn"
    file="$directory/session-mode"
    ;;
esac
# The recorded choice in "$1": desktop only for exactly "desktop", with at
# most one trailing newline; arinn for any other content; nothing when the
# file is missing. arinn-session and arinn-session-switch share this rule.
recorded_mode() {
    [ -f "$1" ] || return 0
    # Command substitution drops NUL bytes; keep them as "?" so "desk\0top"
    # is not read as "desktop".
    content=$(head -c 16 "$1" | tr '\000' '?' && printf x) || content=
    case "$content" in
    "desktop
x" | desktopx) echo desktop ;;
    *) echo arinn ;;
    esac
}

umask 077
mkdir -p "$directory" || exit 3
# What the session would start now: restored as such when the logout fails.
previous=$(recorded_mode "$file")

write() {
    temporary=$(mktemp "$directory/.session-mode.XXXXXX") || return 1
    if printf '%s\n' "$1" >"$temporary" && mv -f "$temporary" "$file"; then
        return 0
    fi
    rm -f "$temporary"
    return 1
}

write "$mode" || exit 3

# The desktop's own dialog waits for the user; a direct logout is bounded.
if [ "$prompt" = true ]; then
    bound=
else
    bound=--timeout=5
fi
logout() {
    case "$desktop:$prompt" in
    plasma:true)
        busctl --user call org.kde.LogoutPrompt /LogoutPrompt org.kde.LogoutPrompt promptLogout
        ;;
    plasma:false)
        busctl --user "$bound" call org.kde.Shutdown /Shutdown org.kde.Shutdown logout
        ;;
    # Logout(show_dialog, allow_save)
    xfce:*)
        busctl --user ${bound:+"$bound"} call org.xfce.SessionManager /org/xfce/SessionManager \
            org.xfce.Session.Manager Logout bb "$prompt" true
        ;;
    esac
}

if logout >/dev/null 2>&1; then
    exit 0
fi
# Never leave a choice behind that the user did not get.
case "$previous" in
arinn | desktop) write "$previous" ;;
*) rm -f "$file" ;;
esac
echo "arinn-session-switch: the desktop did not accept the logout request" >&2
exit 1
