# Return from the plain desktop to the Arinn session (ADR-0107).
[Desktop Entry]
Type=Application
Name=Return to Arinn
Name[ru]=Вернуться в Arinn
Comment=Log out; the next login starts the Arinn TV session
Comment[ru]=Выйти из системы; при следующем входе запустится ТВ-сеанс Arinn
Icon=org.arinn.Shell
Exec=/usr/lib/arinn/arinn-session-switch arinn --prompt
Terminal=false
Categories=System;
Keywords=Arinn;TV;HTPC;Session;
OnlyShowIn=KDE;XFCE;
StartupNotify=false
