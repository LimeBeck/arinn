# Dedicated Arinn login session on XFCE (X11), ADR-0107.
[Desktop Entry]
Type=Application
Name=Arinn (XFCE)
Comment=TV shell on XFCE (X11)
Exec=/usr/lib/arinn/arinn-session xfce
TryExec=startxfce4
DesktopNames=XFCE
