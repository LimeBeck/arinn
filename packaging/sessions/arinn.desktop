# Dedicated Arinn login session on KDE Plasma (Wayland), ADR-0107.
[Desktop Entry]
Type=Application
Name=Arinn
Comment=TV shell on KDE Plasma (Wayland)
Exec=/usr/lib/arinn/arinn-session plasma
TryExec=startplasma-wayland
DesktopNames=KDE
