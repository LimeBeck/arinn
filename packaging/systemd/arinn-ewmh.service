[Unit]
Description=Arinn generic X11 EWMH platform adapter
Documentation=https://github.com/LimeBeck/arinn
PartOf=graphical-session.target arinn-ewmh-session.target
After=graphical-session.target arinnd.service
[Service]
# The process waits across daemon loss and releases org.arinn.X11 with each
# native session. Type=dbus would stop it on that release, preventing recovery.
Type=exec
Environment=ARINN_PLATFORM_BACKEND=ewmh
ExecStart=/usr/bin/arinn-platform-x11
# Gives xfce4-power-manager's power button setting back, however the adapter
# ended (dedicated Arinn XFCE session, ADR-0111). Without xfconf it does nothing.
ExecStopPost=-/usr/bin/arinn-platform-x11 --release-power-key
Restart=on-failure
RestartSec=3s
