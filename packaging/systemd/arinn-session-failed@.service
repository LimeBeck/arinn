#
# OnFailure= handler of arinnd.service and arinn-shell.service (#437); the
# instance is the failed unit. When that unit hit its start limit, it shows a
# desktop notification. It restarts nothing and takes no power action.
[Unit]
Description=Arinn failure notice for %i
Documentation=https://github.com/LimeBeck/arinn
# Since systemd 254 it runs before every automatic restart too, about six
# times in 10 s in a crash loop; the last start is the one that matters.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/arinn/arinn-session-failed %i
