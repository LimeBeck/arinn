[Unit]
Description=Arinn TV shell
Documentation=https://github.com/LimeBeck/arinn
Wants=arinnd.service
PartOf=graphical-session.target arinn-session.target
After=graphical-session.target arinnd.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
# Ready once it owns its bus name; a second instance exits without a window.
Type=dbus
BusName=org.arinn.Shell1
ExecStart=/usr/bin/arinn-shell
Environment=QT_QPA_PLATFORM=wayland
Restart=on-failure
# Exit status 2: another shell owns org.arinn.Shell1; restarting cannot help.
RestartPreventExitStatus=2
RestartSec=2s
