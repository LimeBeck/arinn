[Unit]
Description=Arinn TV shell
Documentation=https://github.com/LimeBeck/arinn
Wants=arinnd.service
PartOf=graphical-session.target arinn-session.target arinn-ewmh-session.target
After=graphical-session.target arinnd.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
# Ready once it owns its bus name; a second instance exits without a window.
Type=dbus
BusName=org.arinn.Shell1
ExecStart=/usr/lib/arinn/arinn-shell-launch
# Exit status 75 asks to restart Arinn after an update (ADR-0098): the
# launcher restarts arinnd, and the unit restarts the shell.
ExecStopPost=/usr/lib/arinn/arinn-shell-launch --stopped
RestartForceExitStatus=75
Restart=on-failure
# Exit status 2: duplicate shell ownership, unsupported backend, or display
# mismatch in the launcher; the journal reason distinguishes these cases.
RestartPreventExitStatus=2
RestartSec=2s
