#
# Geniatron G60S PRO BT air mouse ("ZhenYe Tech BLE Remote", input ID bus
# 0x3, vendor 0x1915, product 0x1001). Its microphone button (MSC_SCAN
# c00cf, Consumer Voice Command) sends KEY_VOICECOMMAND (582), which Qt
# cannot name and X11 does not deliver. Remap it to KEY_PROG1 (148,
# XF86Launch1, Qt Launch1): the on-screen keyboard key next to
# keyboard_shortcut (ADR-0105). Only this vendor/product and this one usage
# code change. Applies after `systemd-hwdb update` (done by the package
# manager's hook) and when the remote reconnects or `udevadm trigger` runs.
evdev:input:b0003v1915p1001*
 KEYBOARD_KEY_c00cf=prog1
