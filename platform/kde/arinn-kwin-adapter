#!/bin/sh
# SPDX-FileCopyrightText: 2026 Arinn contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Load or unload Arinn's packaged KWin script in the running KWin session
# (ADR-0032, ADR-0042). Used by arinn-kwin.service; changes no KWin settings.
set -eu
script=${ARINN_KWIN_SCRIPT:-/usr/share/arinn/kwin/phase0.js}
name=arinn
# Optional Activity background producer (ADR-0087): a declarative script that
# needs the org.arinn.background QML module. Its failure never fails the unit.
background=${ARINN_KWIN_BACKGROUND_SCRIPT:-/usr/share/arinn/kwin/background.qml}
background_name=arinn-background
scripting() {
    busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting "$@"
}
start_background() {
    [ -r "$background" ] || return 0
    [ "$(scripting isScriptLoaded s "$background_name" 2>/dev/null)" = "b true" ] && return 0
    reply=$(scripting loadDeclarativeScript ss "$background" "$background_name" 2>/dev/null) || reply=
    id=${reply#i }
    case "$id" in
    '' | *[!0-9]*)
        echo "arinn-kwin-adapter: KWin refused the background script; Home keeps its normal background" >&2
        return 0
        ;;
    esac
    busctl --user call org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script run ||
        echo "arinn-kwin-adapter: the background script did not start" >&2
    return 0
}
case "${1:-}" in
start)
    [ -r "$script" ] || { echo "arinn-kwin-adapter: missing $script" >&2; exit 1; }
    # KWin may still be starting with the session: wait up to 10 s.
    tries=0
    until loaded=$(scripting isScriptLoaded s "$name" 2>/dev/null); do
        tries=$((tries + 1))
        [ "$tries" -lt 20 ] || { echo "arinn-kwin-adapter: KWin scripting unavailable" >&2; exit 1; }
        sleep 0.5
    done
    if [ "$loaded" = "b true" ]; then
        start_background
        exit 0
    fi
    # The developer session loads the same adapter; two copies would compete.
    if [ "$(scripting isScriptLoaded s arinn-phase0)" = "b true" ]; then
        echo "arinn-kwin-adapter: the Phase 0 session adapter is loaded; stop it first" >&2
        exit 1
    fi
    reply=$(scripting loadScript ss "$script" "$name")
    id=${reply#i }
    case "$id" in
    '' | *[!0-9]*)
        echo "arinn-kwin-adapter: KWin refused the script" >&2
        exit 1
        ;;
    esac
    busctl --user call org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script run
    start_background
    ;;
stop)
    # The desktop gets the power key back before the action that held it
    # goes (ADR-0111), and applications the remote's Menu key (#507);
    # arinnd's own ExecStopPost does the same.
    "${ARINN_DAEMON:-/usr/bin/arinnd}" --release-power-key >/dev/null 2>&1 || true
    # KWin may already be gone when the graphical session ends.
    scripting unloadScript s "$background_name" >/dev/null 2>&1 || true
    scripting unloadScript s "$name" >/dev/null 2>&1 || true
    ;;
*)
    echo "usage: arinn-kwin-adapter start|stop" >&2
    exit 2
    ;;
esac
