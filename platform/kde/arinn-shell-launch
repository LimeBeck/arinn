# Select the Qt transport for the existing graphical session (ADR-0077).
set -eu
# ExecStopPost of arinn-shell.service (ADR-0098): exit status 75 is the
# shell's request to restart Arinn after an update. The unit restarts the
# shell itself; the daemon, possibly an older build, is restarted here.
if [ "${1:-}" = --stopped ]; then
    if [ "${EXIT_CODE:-}" = exited ] && [ "${EXIT_STATUS:-}" = 75 ]; then
        echo "arinn-shell-launch: restart requested; restarting arinnd" >&2
        systemctl --user --no-block try-restart arinnd.service ||
            echo "arinn-shell-launch: arinnd was not restarted" >&2
    fi
    exit 0
fi
backend=${ARINN_SESSION_BACKEND:-auto}
if [ "$backend" = auto ]; then
    backend=${XDG_SESSION_TYPE:-wayland}
fi
case "$backend" in
wayland)
    if [ -n "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "arinn-shell-launch: Wayland backend has only an X11 display" >&2
        exit 2
    fi
    QT_QPA_PLATFORM=wayland ;;
x11)
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
        echo "arinn-shell-launch: X11 backend has only a Wayland display" >&2
        exit 2
    fi
    QT_QPA_PLATFORM=xcb ;;
*) echo "arinn-shell-launch: unsupported session backend" >&2; exit 2 ;;
esac
export QT_QPA_PLATFORM
exec /usr/bin/arinn-shell "$@"
